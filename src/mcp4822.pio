.program mcp4822
.side_set 2 opt          ; [1]=SCK, [0]=CS  (base = CS pin)
.wrap_target
    pull block
    set x, 15
    nop        side 0b01 ; idle: CS=1, SCK=0
    nop        side 0b00 ; CS=0
bitloop:
    out pins, 1 side 0b00
    nop        side 0b10 ; SCK↑
    jmp x-- bitloop side 0b00
    nop        side 0b01 ; CS=1 (latch)
.wrap
